# copy to .env before running docker compose

# Where the browser (not the container) reaches llm-service. Since this is
# baked in at BUILD time (see Dockerfile), a browser-reachable URL is
# required -- a Docker-internal service name like "http://llm-service:8000"
# only resolves for other containers, not for someone's browser. Use the
# host-mapped port (e.g. http://localhost:8001, or your real domain once
# deployed) unless you're serving everything through a reverse proxy on
# one origin.
VITE_LLM_SERVICE_URL=http://localhost:8001

FRONTEND_PORT=3000
