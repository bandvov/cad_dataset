# copy to .env before running docker compose

# GGUF filename expected in ./models/ -- produce it with the `convert`
# profile service (see docker-compose.yml) from a merged model produced by
# ../training/merge_adapter.py
GGUF_FILENAME=model.gguf
QUANT_TYPE=Q4_K_M

# GPU image by default; see docker-compose.yml comment for CPU-only setup
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMACPP_CONVERT_IMAGE=ghcr.io/ggml-org/llama.cpp:full-cuda
N_GPU_LAYERS=999
CTX_SIZE=4096
LLAMACPP_PORT=8080

LLM_SERVICE_PORT=8001
HTTP_TIMEOUT=60

# only needed if NOT running the combined stack with ../service/docker-compose.yml
GEOMETRY_SERVICE_URL=http://geometry:8000
