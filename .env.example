# copy to .env before running `docker compose up --build` at the repo root

# ---- geometry service ----
SERVICE_PORT=8000
# number of persistent worker subprocesses -- each holds its own build123d
# import in memory, so this is mostly a memory/CPU tradeoff, not a
# correctness one. Start at your host's core count / 2 and measure.
POOL_SIZE=4
# per-job wall-clock timeout (seconds) -- a job exceeding this kills and
# respawns its worker rather than blocking the pool
JOB_TIMEOUT=20
# best-effort per-worker resource ceilings, see service/worker_pool.py docstring
WORKER_MEM_LIMIT_MB=2048
WORKER_CPU_LIMIT_S=30
# container-level backstop (the real safeguard) -- size for
# POOL_SIZE * WORKER_MEM_LIMIT_MB plus headroom
SERVICE_CPU_LIMIT=4
SERVICE_MEM_LIMIT=8g

# ---- llama.cpp ----
# GGUF filename expected in ./llm-service/models/ -- produce it from a
# merged model (../training/merge_adapter.py) via llm-service's `convert`
# profile: cd llm-service && docker compose --profile tools run --rm convert
GGUF_FILENAME=model.gguf
# GPU image by default -- for CPU-only, override to
# ghcr.io/ggml-org/llama.cpp:server and set N_GPU_LAYERS=0 (also remove
# the llamacpp service's deploy.resources block in docker-compose.yml)
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
N_GPU_LAYERS=999
CTX_SIZE=4096
LLAMACPP_PORT=8080

# ---- llm-service (orchestrator) ----
LLM_SERVICE_PORT=8001
HTTP_TIMEOUT=60

# prints the model's raw output, parsed IR, and compile results to
# container logs on every generate attempt -- on by default, set to 0 to
# quiet it down once you're not actively debugging generations
LLM_SERVICE_DEBUG=1

# ---- auth step 9: session + rate-limit config ----
# Hours a session token stays valid after login/signup. Blank/unset =
# never expires. Not a security backstop -- opaque tokens are revoked
# immediately via POST /v1/auth/logout regardless of this setting; this
# only controls how long an UNUSED token keeps working on its own.
SESSION_LIFETIME_HOURS=720

# Requests/minute allowed per authenticated user. Read by auth step 13's
# rate-limit middleware, which is NOT implemented yet (see
# SESSION_HANDOFF.md) -- the knob is added now so it exists before the
# middleware does, rather than bundling both changes together.
RATE_LIMIT_PER_MINUTE=60

# ---- frontend ----
# Must be reachable from the BROWSER, not just other containers -- see
# docker-compose.yml's comment on the frontend service. Default assumes
# you're opening the app from the same machine the stack runs on.
VITE_LLM_SERVICE_URL=http://localhost:8001
FRONTEND_PORT=3000
