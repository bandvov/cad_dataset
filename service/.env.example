# copy to .env before running docker compose
SERVICE_PORT=8000

# number of persistent worker subprocesses -- each holds its own build123d
# import in memory, so this is mostly a memory/CPU tradeoff, not a
# correctness one. Start at your host's core count / 2 and measure.
POOL_SIZE=4

# per-job wall-clock timeout (seconds) -- a job exceeding this kills and
# respawns its worker rather than blocking the pool
JOB_TIMEOUT=20

# best-effort per-worker resource ceilings, see worker_pool.py docstring
WORKER_MEM_LIMIT_MB=2048
WORKER_CPU_LIMIT_S=30

# container-level backstop (the real safeguard) -- size for
# POOL_SIZE * WORKER_MEM_LIMIT_MB plus headroom
SERVICE_CPU_LIMIT=4
SERVICE_MEM_LIMIT=8g
