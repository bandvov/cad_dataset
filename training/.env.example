# copy to .env and fill in before running docker compose
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# google/gemma-4-E2B-it (smallest, ~8-10GB VRAM w/ QLoRA) through
# google/gemma-4-31B-it (largest dense, 40GB+) -- pick based on your GPU.
# All are gated on Hugging Face; accept the license on the model page first.
MODEL_ID=google/gemma-4-E4B-it

USE_QLORA=1
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05

MAX_SEQ_LEN=2048
BATCH_SIZE=2
GRAD_ACCUM=8
LEARNING_RATE=2e-4
NUM_EPOCHS=3
EVAL_STEPS=100
SAVE_STEPS=100
GEOMETRY_EVAL_SAMPLES=20

# 0 disables periodic mid-training VRAM+RAM unload (always-on cleanup
# around GeometryEvalCallback's generate() calls happens regardless --
# this is ADDITIONAL cleanup during plain training steps). Only turn on
# if you're actually seeing fragmentation-driven OOMs mid-run; the sync
# point has real overhead. Try e.g. 200 if needed.
EMPTY_CACHE_EVERY_N_STEPS=0

# set to "auto" to resume from the latest checkpoint in OUTPUT_DIR after a
# crash, or a specific checkpoint path (e.g. /workspace/outputs/adapter/checkpoint-84).
# Leave blank for a fresh run.
RESUME_FROM_CHECKPOINT=

# used by the `compare` service (Phase 4 step 12) -- point OLD_ADAPTER at
# the currently-promoted adapter and NEW_ADAPTER at the one you're
# deciding whether to promote
OLD_ADAPTER=/workspace/outputs/adapter_old
NEW_ADAPTER=/workspace/outputs/adapter
COMPARE_N_SAMPLES=50

# "none", "wandb", or "tensorboard"
REPORT_TO=none
WANDB_API_KEY=
